extends EventHandler;
"field strict";

\createEvent(raw) {
    var e={};
    e.keyCode=e.code=raw.keyCode;
    e.keyName=e.name=$Keys.codesRev[e.keyCode];
    if (!e.name) e.keyName=e.name=e.code+"";
    e.sendUps=[];
    let ent;
    e.on=\(name,f) {
        if (name==="keyUp"||name==="up") {
            e.sendUps.push(f);
        }  
        if (name==="enterFrame") {
            ent=$Boot.on("enterFrame",f);
        }
    };
    e.sendUp=\() {
        if (ent) ent.remove();
        for (var f of e.sendUps) f();
    };
    return e;   
}
var handlers,pressState;
\new() {
    super();
    handlers={};
    pressState={};
    $InputDevice.on("keyDownRaw") \(raw) {
        if (pressState[raw.keyCode]) return;
        var a=pressState[raw.keyCode]=[];
        var e=createEvent(raw);
        a.push(e);
        if (handlers[raw.keyCode]) {
            for (var f of handlers[raw.keyCode]) {
                f(e);
            }
        }
        if (handlers.all) {
            for (var f of handlers.all) {
                f(e);
            }
        }
    };
    $InputDevice.on("keyUpRaw") \(e) {
        var a=pressState[e.keyCode]=pressState[e.keyCode]||[];
        delete pressState[e.keyCode];
        for (var e of a) {
            e.sendUp();
        }
    };
}
\newListener() {
    // (f)
    // (number, f)
    // (string, f)
    let pa=new ArgParser(arguments);
    let keyName=pa.shift("number")||pa.shift("string");
    var keyCode=
    keyName==null ? "all" :
    typeof keyName==="number" ? keyName : $Keys.codes[keyName];
    let f=pa.shift("function");
    if (!f) {
        throw new Error("keyDown: Handler is not set");
    }
    handlers[keyCode]=handlers[keyCode]||[];
    var a=handlers[keyCode];
    /*
    if (!f) {
        f=keyName;
        a=handlers.all=handlers.all||[];
    } else {
        a=handlers[keyCode]=handlers[keyCode]||[];
    }*/
    a.push(f);
    return {
        dispose: \{
            var i=a.indexOf(f);
            a.splice(i,1);
        }  
    };
}